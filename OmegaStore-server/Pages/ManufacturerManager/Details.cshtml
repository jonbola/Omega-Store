@page
@model OmegaStore_server.Pages_ManufacturerManager.DetailsModel

@{
    ViewData["Title"] = "Manufacturer Detail";
}

<h1>Details</h1>

<div>
    <h4>Manufacturer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Manufacturer.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Manufacturer.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Manufacturer.Address)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Manufacturer.Address)
        </dd>
    </dl>
    <h4>Product List</h4>
    <hr />
    <table class="table">
        <thead>
            <tr>
                <th>
                    No.
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Products[0].Name)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products.Select((Product, Index) => new { Product, Index }))
            {
                <tr>
                    <td>
                        @(item.Index + 1)
                    </td>
                    <td>
                        <a href="/ProductManager/Details/?id=@item.Product.Id">@item.Product.Name</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Manufacturer.Id">Edit</a> |
    <a asp-page="./Delete" asp-route-id="@Model.Manufacturer.Id">Delete</a> |
    <a asp-page="./Index">Back to List</a>
</div>