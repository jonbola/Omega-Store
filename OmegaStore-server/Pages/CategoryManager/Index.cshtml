@page
@model OmegaStore_server.Pages_CategoryManager.IndexModel

@{
    ViewData["Title"] = "Category Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<br>
<form style="display: flex; flex-direction: row;">
    <h4 style="flex: 1;">Search:</h4>
    <input type="text" asp-for="SearchString" class="form-control" style="flex: 4;">
    <span style="flex: 5;"></span>
</form>
<br>
<table class="table">
    <thead>
        <tr>
            <th>
                No.
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categories[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categories[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categories[0].Products)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories.Select((Category, Index) => new { Category, Index }))
        {
            <tr>
                <td>
                    @(item.Index + 1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.Name)
                </td>
                <td style="max-width: 400px;">
                    @Html.DisplayFor(modelItem => item.Category.Description)
                </td>
                <td>
                    <select class="form-control" size="5">
                        @if (item.Category.Products != null)
                        {
                            foreach (var product in item.Category.Products)
                            {
                                <option value="@product.Id" ondblclick="RedirectToProductDetailPage(@product.Id)">
                                    @product.Name
                                </option>
                            }
                        }
                    </select>
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Category.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Category.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Category.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function RedirectToProductDetailPage(productId) {
        window.location.href = "/ProductManager/Details/?id=" + productId;
    }
</script>