@page
@model OmegaStore_server.Pages_AccountManager.IndexModel

@{
    ViewData["Title"] = "Account Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<br>
<form style="display: flex; flex-direction: row;">
    <h4 style="flex: 1;">Search:</h4>
    <input type="text" asp-for="SearchString" class="form-control" style="flex: 4;">
    <span style="flex: 5;"></span>
</form>
<br>
<table class="table">
    <thead>
        <tr>
            <th>
                No.
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].AccountName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].Role)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].Editable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].Deletable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accounts[0].CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Accounts.Select((Account, Index) => new { Account, Index }))
        {
            <tr>
                <td>
                    @(item.Index + 1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account.AccountName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account.Password)
                </td>
                <td>
                    @(item.Account.Role ? "Admin" : "Customer")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account.Editable)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account.Deletable)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account.CreatedDate)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Account.Id" data-editable="@item.Account.Editable"
                        class="account-edit-btn">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Account.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Account.Id" data-deletable="@item.Account.Deletable"
                        class="account-delete-btn">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @await Html.PartialAsync("~/Assets/Scripts/AccountButtonsScript.cshtml")
}