@page
@model OmegaStore_server.Pages_AccountManager.DetailsModel

@{
    ViewData["Title"] = "Account Detail";
}

<h1>Details</h1>

<div>
    <h4>Account</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.Password)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.Password)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.Role)
        </dt>
        <dd class="col-sm-10">
            @(Model.Account.Role ? "Admin" : "Customer")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.Editable)
        </dt>
        <dd class="col-sm-10">
            @(Model.Account.Editable ? "Yes" : "No")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.Deletable)
        </dt>
        <dd class="col-sm-10">
            @(Model.Account.Deletable ? "Yes" : "No")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.CreatedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.CreatedDate)
        </dd>
    </dl>
</div>

<div>
    <h4>Info</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountInfo!.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountInfo!.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountInfo!.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountInfo!.PhoneNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.Gender)
        </dt>
        <dd class="col-sm-10">
            @GetTextList.GetGenderText(Model.Account.AccountInfo!.Gender!)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.Nation)
        </dt>
        <dd class="col-sm-10">
            @GetTextList.GetNationText(Model.Account.AccountInfo.Nation!)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Account.AccountInfo!.BirthDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountInfo!.BirthDate)
        </dd>
    </dl>
</div>

<div>
    <h4>Purchase List</h4>
    <hr />
    <table class="table">
        <thead>
            <tr>
                <th>
                    No.
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Purchases[0].TotalPurchase)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Purchases[0].PurchaseDate)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Purchases.Select((Purchase, Index) => new { Purchase, Index }))
            {
                <tr>
                    <td>
                        @(item.Index + 1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Purchase.TotalPurchase)$
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Purchase.PurchaseDate)
                    </td>
                    <td>
                        <a asp-page="/PurchaseManager/Details" asp-route-id="@item.Purchase.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Account.Id" data-editable="@Model.Account.Editable"
        class="account-edit-btn">Edit</a> |
    <a asp-page="./Delete" asp-route-id="@Model.Account.Id" data-deletable="@Model.Account.Deletable"
        class="account-delete-btn">Delete</a> |
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Assets/Scripts/AccountButtonsScript.cshtml")
}