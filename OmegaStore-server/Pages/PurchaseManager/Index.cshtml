@page
@model OmegaStore_server.Pages_PurchaseManager.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                No.
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Purchases[0].Account)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Purchases[0].TotalPurchase)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Purchases[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Purchases[0].PurchaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Purchases.Select((Purchase, Index) => new { Purchase, Index }))
        {
            <tr>
                <td>
                    @(item.Index + 1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Purchase.Account!.AccountName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Purchase.TotalPurchase)$
                </td>
                <td>
                    @(item.Purchase.Status ? "Completed" : "Pending")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Purchase.PurchaseDate)
                </td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.Purchase.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>