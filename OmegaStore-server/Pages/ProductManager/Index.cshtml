@page
@model OmegaStore_server.Pages_ProductManager.IndexModel

@{
    ViewData["Title"] = "Product Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<br>
<form style="display: flex; flex-direction: row;">
    <h4 style="flex: 1;">Search:</h4>
    <input type="text" asp-for="SearchString" class="form-control" style="flex: 4;">
    <span style="flex: 5;"></span>
</form>
<br>
<table class="table">
    <thead>
        <tr>
            <th>
                No.
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].WarrantyPeriod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Sale)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Manufacturer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products.Select((Product, Index) => new { Product, Index }))
        {
            <tr>
                <td>
                    @(item.Index + 1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Product.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Product.Price)$
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Product.Stock)
                </td>
                <td>
                    @(item.Product.WarrantyPeriod == null ? "" : item.Product.WarrantyPeriod + " " +
                                    (item.Product.WarrantyPeriod <= 1 ? "month"
                                    : "months"))
                </td>
                <td>
                    @(item.Product.Sale + " " + (item.Product.Sale <= 1 ? "unit" : "units"))
                </td>
                <td>
                    <a href="/CategoryManager/Details/?id=@item.Product.CategoryId">@item.Product.Category!.Name</a>
                </td>
                <td>
                    <a
                        href="/ManufacturerManager/Details/?id=@item.Product.ManufacturerId">@item.Product.Manufacturer!.Name</a>
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Product.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Product.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Product.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>